cmake_minimum_required(VERSION 3.21)
if(NOT EXISTS "${CHESS_STORAGE_TEST_EXE}" OR NOT IS_ABSOLUTE "${CHESS_TEST_ROOT}")
    message(FATAL_ERROR "An existing test executable and absolute test root are required.")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _id)
set(_root "${CHESS_TEST_ROOT}/${_id}")
file(MAKE_DIRECTORY "${_root}/install" "${_root}/launch-a" "${_root}/launch-b")
get_filename_component(_name "${CHESS_STORAGE_TEST_EXE}" NAME)
file(COPY "${CHESS_STORAGE_TEST_EXE}" DESTINATION "${_root}/install")
set(_test "${_root}/install/${_name}")

function(run mode config working_dir)
    file(MAKE_DIRECTORY "${working_dir}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "CHESS_CONFIG_DIR=${config}"
        "${_test}" "${mode}" ${ARGN}
        WORKING_DIRECTORY "${working_dir}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "${mode} failed (${_result})\n${_out}\n${_err}\nFixtures: ${_root}")
    endif()
    message(STATUS "${_out}")
endfunction()

run(write "${_root}/user-config" "${_root}/launch-a")
file(WRITE "${_root}/launch-b/settings.dat" "theme=0\n")
run(check "${_root}/user-config" "${_root}/launch-b" 2)
run(update "${_root}/user-config" "${_root}/launch-a")
run(check "${_root}/user-config" "${_root}/launch-b" 1)
run(recover "${_root}/user-config" "${_root}/launch-a")
run(check "${_root}/user-config" "${_root}/launch-b" 2)
run(write "${_root}/backup-only" "${_root}/launch-a")
run(update "${_root}/backup-only" "${_root}/launch-a")
file(REMOVE "${_root}/backup-only/settings.dat")
file(WRITE "${_root}/backup-only/settings.dat.bak" "CSO1")
run(unreadable "${_root}/backup-only" "${_root}/launch-a")
run(migrate_plain "${_root}/plain-user" "${_root}/plain-legacy")
run(migrate_bom "${_root}/bom-user" "${_root}/bom-legacy")
run(migrate_encrypted "${_root}/encrypted-user" "${_root}/encrypted-legacy")
run(migrate_nested "${_root}/nested-user" "${_root}/nested-legacy")
run(malformed_numbers "${_root}/numeric-user" "${_root}/numeric-legacy")
run(corrupt_without_backup "${_root}/corrupt-user" "${_root}/launch-a")
run(save_failure "${_root}/failure-user" "${_root}/launch-a")
run(check "${_root}/failure-user" "${_root}/launch-a" 2)
run(atomic_failure "${_root}/atomic-user" "${_root}/launch-a")
run(container_validation "${_root}/container-user" "${_root}/launch-a")
run(legacy_container "${_root}/v1-user" "${_root}/launch-a")
run(invalid_directory "relative-directory" "${_root}/launch-a")
run(write "${_root}/تنظیمات کاربر/Chess" "${_root}/launch-a")
run(check "${_root}/تنظیمات کاربر/Chess" "${_root}/launch-b" 2)
string(REPEAT "nested-directory-" 5 _segment)
run(write "${_root}/${_segment}/${_segment}/${_segment}/Chess" "${_root}/launch-a")
run(check "${_root}/${_segment}/${_segment}/${_segment}/Chess" "${_root}/launch-b" 2)
run(default_path "" "${_root}/launch-a")

# Only remove this run's fixtures after verifying their resolved containment.
file(REAL_PATH "${CHESS_TEST_ROOT}" _expected)
file(REAL_PATH "${_root}" _actual)
string(FIND "${_actual}" "${_expected}/" _within)
if(NOT _within EQUAL 0 OR _actual STREQUAL _expected)
    message(FATAL_ERROR "Refusing cleanup outside the test root: ${_actual}")
endif()
file(REMOVE_RECURSE "${_actual}")
