# Script mode must receive compiler and tool paths from the configuring build.
function(chess_stage_windows_runtime executable destination)
    get_filename_component(_exe_dir "${executable}" DIRECTORY)
    get_filename_component(_compiler_dir "${CHESS_COMPILER}" DIRECTORY)
    set(_search_dirs "${destination}" "${_exe_dir}" "${_compiler_dir}"
        "${CHESS_SOURCE_DIR}" "${CHESS_SOURCE_DIR}/runtime/windows")
    string(REPLACE "|" ";" _explicit_dlls "${CHESS_RUNTIME_DLLS}")
    foreach(_dll IN LISTS _explicit_dlls)
        if(EXISTS "${_dll}")
            file(COPY "${_dll}" DESTINATION "${destination}")
            get_filename_component(_dll_dir "${_dll}" DIRECTORY)
            list(APPEND _search_dirs "${_dll_dir}")
        endif()
    endforeach()
    set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
    if(CHESS_COMPILER_ID STREQUAL "GNU" OR CHESS_OBJDUMP)
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
        if(EXISTS "${CHESS_OBJDUMP}")
            set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${CHESS_OBJDUMP}")
        else()
            find_program(_objdump NAMES objdump REQUIRED)
            set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${_objdump}")
        endif()
    else()
        find_program(_dumpbin NAMES dumpbin REQUIRED)
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
        set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${_dumpbin}")
    endif()
    # Filter resolved OS paths before CMake recursively inspects their imports.
    # Filtering only the final copy list still visits optional Windows components
    # that may not be present on a hosted runner (for example HvsiFileTrust.dll).
    set(_system_exclusions)
    foreach(_system_root IN ITEMS "$ENV{WINDIR}" "$ENV{SystemRoot}")
        if(_system_root STREQUAL "")
            continue()
        endif()
        file(TO_CMAKE_PATH "${_system_root}" _system_root)
        string(REGEX REPLACE "/+$" "" _system_root "${_system_root}")
        set(_pattern "^")
        string(LENGTH "${_system_root}" _length)
        math(EXPR _last "${_length} - 1")
        foreach(_index RANGE 0 ${_last})
            string(SUBSTRING "${_system_root}" ${_index} 1 _character)
            if(_character MATCHES "^[A-Za-z]$")
                string(TOLOWER "${_character}" _lower)
                string(TOUPPER "${_character}" _upper)
                string(APPEND _pattern "[${_lower}${_upper}]")
            elseif(_character STREQUAL "/")
                string(APPEND _pattern [=[[/\\]]=])
            else()
                string(APPEND _pattern "\\${_character}")
            endif()
        endforeach()
        string(APPEND _pattern [=[[/\\]]=])
        list(APPEND _system_exclusions "${_pattern}")
    endforeach()
    file(GET_RUNTIME_DEPENDENCIES
        EXECUTABLES "${executable}"
        DIRECTORIES ${_search_dirs}
        RESOLVED_DEPENDENCIES_VAR _resolved
        UNRESOLVED_DEPENDENCIES_VAR _unresolved
        PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-.*" "^[Ee][Xx][Tt]-[Mm][Ss]-.*"
        POST_EXCLUDE_REGEXES ${_system_exclusions})
    if(_unresolved)
        message(FATAL_ERROR "Cannot package an incomplete runtime. Unresolved DLLs: ${_unresolved}")
    endif()
    set(_manifest "${executable}\n")
    foreach(_dll IN LISTS _resolved)
        file(COPY "${_dll}" DESTINATION "${destination}")
        string(APPEND _manifest "${_dll}\n")
    endforeach()
    file(WRITE "${CHESS_OUT_DIR}/runtime_manifest.txt" "${_manifest}")
endfunction()
